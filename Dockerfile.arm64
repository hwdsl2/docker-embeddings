# Builds TEI (text-embeddings-router) from source for arm64/aarch64.
# The arm64 build uses the ONNX Runtime + Candle backends with static linking.
# Build info: https://github.com/huggingface/text-embeddings-inference

# TEI source version (passed via --build-arg in GitHub Actions, defaults to latest release)
ARG TEI_VERSION=v1.9.3

FROM lukemathwalker/cargo-chef:latest-rust-1.92-bookworm AS chef
WORKDIR /usr/src

FROM chef AS planner

ARG TEI_VERSION
ADD https://github.com/huggingface/text-embeddings-inference/archive/refs/tags/${TEI_VERSION}.tar.gz /tmp/tei.tar.gz
RUN tar -xzf /tmp/tei.tar.gz --strip-components=1 -C /usr/src && rm /tmp/tei.tar.gz
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /usr/src/recipe.json recipe.json
RUN cargo chef cook --release --features ort,candle,static-linking --no-default-features --recipe-path recipe.json

ARG TEI_VERSION
ADD https://github.com/huggingface/text-embeddings-inference/archive/refs/tags/${TEI_VERSION}.tar.gz /tmp/tei.tar.gz
RUN tar -xzf /tmp/tei.tar.gz --strip-components=1 -C /usr/src && rm /tmp/tei.tar.gz

RUN cargo build --release --bin text-embeddings-router --features ort,candle,static-linking,http --no-default-features

# --- Runtime stage ---
FROM debian:bookworm-slim

ENV HUGGINGFACE_HUB_CACHE=/var/lib/embeddings \
    LD_LIBRARY_PATH=/usr/local/lib \
    RAYON_NUM_THREADS=8

# Install the compiled TEI binary
COPY --from=builder /usr/src/target/release/text-embeddings-router /usr/local/bin/text-embeddings-router

# Install Python (for manage.sh model pre-download) and curl (for health checks).
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       python3 python3-venv python3-pip \
       curl ca-certificates libssl-dev libomp-dev \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir --uploaded-prior-to P7D huggingface_hub \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/embeddings

WORKDIR /opt/src

COPY ./run.sh /opt/src/run.sh
COPY ./manage.sh /opt/src/manage.sh
COPY ./LICENSE.md /opt/src/LICENSE.md
RUN chmod 755 /opt/src/run.sh /opt/src/manage.sh \
    && ln -s /opt/src/manage.sh /usr/local/bin/embed_manage

EXPOSE 8000/tcp 8001/tcp
VOLUME ["/var/lib/embeddings"]
CMD ["/opt/src/run.sh"]

ARG BUILD_DATE
ARG VERSION
ARG VCS_REF
ENV IMAGE_VER=$BUILD_DATE
ENV IMAGE_FLAVOR=$VERSION

LABEL maintainer="Lin Song <linsongui@gmail.com>" \
    org.opencontainers.image.created="$BUILD_DATE" \
    org.opencontainers.image.version="$VERSION" \
    org.opencontainers.image.revision="$VCS_REF" \
    org.opencontainers.image.authors="Lin Song <linsongui@gmail.com>" \
    org.opencontainers.image.title="Text Embeddings & Reranking API on Docker" \
    org.opencontainers.image.description="Docker image to run a self-hosted text embeddings and reranking server powered by Hugging Face TEI, providing an OpenAI-compatible /v1/embeddings API and a /rerank endpoint." \
    org.opencontainers.image.url="https://github.com/hwdsl2/docker-embeddings" \
    org.opencontainers.image.source="https://github.com/hwdsl2/docker-embeddings" \
    org.opencontainers.image.documentation="https://github.com/hwdsl2/docker-embeddings"
